{
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  "overrides": [
    {
      "includes": ["api/graphql/generated/**", "api/rest/generated/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["api/rest/generated/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["fixtures/**", "tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    {
      "includes": ["dataset/manifest.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
